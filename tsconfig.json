{
	"compilerOptions": {
		"lib": ["es2023", "dom"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "es2022",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"emitDeclarationOnly": false,
		"rootDir": "./src",
		"outDir": ".dist",
		"types": ["node", "jest"]
	},
	"include": ["src/**/*"],
	"exclude": ["src/__tests__/**/*.ts"]
}
